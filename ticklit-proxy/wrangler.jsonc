{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ticklit-proxy",
	"main": "src/index.js",
	"compatibility_date": "2026-07-24",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "CHART_CACHE",
			"id": "c29408ac37f4462eaa7160acd28c2dcf"
		}
	],
	"triggers": {
		"crons": ["0 6 * * *"]
	}
}